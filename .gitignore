# MindGraph shared state (commit)
!.mindgraph/
!.mindgraph/README.md
!.mindgraph/config.json
!.mindgraph/nodes/
!.mindgraph/nodes/**
!.mindgraph/graph/
!.mindgraph/graph/**
# MindGraph local state (do not commit)
.env
.env.*
!.env.example
.mindgraph/memory.db
.mindgraph/memory.db-*
.mindgraph/pending-session.json
.mindgraph/graph.html
.mindgraph/local.json
.mindgraph/local.json.sync.lock
.mindgraph/*.tmp.*
.mindgraph/**/*.tmp.*
